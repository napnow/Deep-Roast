# ── 深焙 Deep Roast · 环境变量示例 ──
# 复制为 .env.local 后填写真实值（.env.local 不会进 git）

# PostgreSQL（必填）
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/deep_roast

# JWT 签名密钥（必填；生产环境必须设置强随机串）
# 生成示例: openssl rand -base64 32
JWT_SECRET=replace-with-a-long-random-string

# 首次 seed 管理员密码（可选；不设则 seed 使用弱默认并打印警告，仅本地）
ADMIN_PASSWORD=change-me-on-first-login

# ── LLM / 图像上游（也可在应用「设置」里配置，优先生效）──
# OpenAI 兼容 Base URL，例如 https://api.example.com/v1
# ARK_API_KEY=
# GROK_API_KEY=
# GROK_BASE_URL=
# GPT_IMAGE_KEY=
# GPT_IMAGE_BASE_URL=
# GEMINI_API_KEY=
# GEMINI_BASE_URL=
