# Local development: copy this file to .env.local and fill in your own values.
# Production: keep environment files OUTSIDE release artifacts and Git.
DATABASE_URL=postgres://deeproast:replace_me@127.0.0.1:5432/deeproast
JWT_SECRET=
# 32 random bytes encoded as Base64; required for encrypted API keys.
API_KEY_ENCRYPTION_KEY=
IMAGE_URL_SIGNING_KEY=
# Production must use an HTTPS origin, without a path or credentials.
PUBLIC_APP_URL=https://your-app.example.com
# Production: set an absolute, persistent directory outside public/ and releases.
DEEPROAST_DATA_DIR=
ADMIN_PASSWORD=
# Optional providers; administrator settings can configure model channels instead.
ARK_API_KEY=
GROK_API_KEY=
GROK_BASE_URL=
GPT_IMAGE_KEY=
GPT_IMAGE_BASE_URL=
GEMINI_API_KEY=
GEMINI_BASE_URL=
# Optional rate-limit backing store.
REDIS_URL=
