# ── 深焙 Deep Roast · 环境变量示例 ──
# 复制为 .env.local 后填写真实值（.env.local 不会进 git）

# PostgreSQL（必填）
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/deep_roast

# Redis（可选；配置后启用 Redis 频率限流，多实例部署共享计数。
# 未配置或连接失败时自动降级为进程内内存限流）
REDIS_URL=redis://localhost:6379

# JWT 签名密钥（必填；生产环境必须设置强随机串）
# 生成示例: openssl rand -base64 32
JWT_SECRET=replace-with-a-long-random-string

# API Key 加密密钥（使用 API Key 功能时必填；必须是 32 字节 Base64）
# 生成示例: openssl rand -base64 32
API_KEY_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# 单 IP 注册限制的白名单（可选；逗号分隔，如 1.2.3.4,5.6.7.8）。
# 这些 IP 可注册多个账号（例如开发/测试机）。开发环境默认不限制。
# REGISTRATION_BYPASS_IPS=

# 首次 seed 创建管理员时必填；已有管理员账号不会被修改
ADMIN_PASSWORD=change-me-on-first-seed

# 公网根地址（使用 OpenAI 兼容网关或邀请链接时配置 HTTPS 根域名）
# PUBLIC_APP_URL=https://example.com

# ── LLM / 图像上游（也可在应用「设置」里配置）──
# OpenAI 兼容 Base URL，例如 https://api.example.com/v1
# ARK_API_KEY=
# GROK_API_KEY=
# GROK_BASE_URL=
# GPT_IMAGE_KEY=
# GPT_IMAGE_BASE_URL=
# GEMINI_API_KEY=
# GEMINI_BASE_URL=
