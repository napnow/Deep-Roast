# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — keep example
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated user content (keep directory via .gitkeep)
/public/images/*
!/public/images/.gitkeep
/public/uploads/*
!/public/uploads/.gitkeep

# local notes / agent scratch
doubaome.md
.superpowers/
.claude/

# OS / editor
.idea/
.vscode/
*.swp
