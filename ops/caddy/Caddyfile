(cloudflare-only) {
    @notCloudflare {
        not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
    }
}

(deeproast-security-headers) {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "SAMEORIGIN"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }
}

(deeproast-client-ip) {
    header_up -CF-Connecting-IP
    header_up -X-Forwarded-For
    header_up -X-Real-IP
    header_up X-Real-IP {http.request.client_ip}
    header_up X-Forwarded-For {http.request.client_ip}
}

grok.deeproast.sryze.cc {
    import cloudflare-only
    @videos path /v1/media/videos/*
    route {
        respond @notCloudflare 403
        header @videos Content-Disposition "attachment; filename=\"video.mp4\""
        reverse_proxy 127.0.0.1:5661 {
            import deeproast-client-ip
        }
    }
}

api.deeproast.sryze.cc {
    import cloudflare-only
    route {
        respond @notCloudflare 403
        reverse_proxy 127.0.0.1:2567 {
            import deeproast-client-ip
        }
    }
}

deeproast.sryze.cc {
    import cloudflare-only
    import deeproast-security-headers

    route {
        respond @notCloudflare 403

        @privateImages path /images/*
        respond @privateImages 404
        handle /uploads/* {
            root * /opt/deeproast-current/public
            file_server
        }
        handle {
            reverse_proxy 127.0.0.1:3000 {
            import deeproast-client-ip
        }
        }
    }
}
